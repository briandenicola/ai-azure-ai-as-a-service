        </elementProp>
        <stringProp name="ThreadGroup.num_threads">2</stringProp>
        <stringProp name="ThreadGroup.ramp_time">5</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">3600</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
      </ThreadGroup>
      <hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager"
                       testname="Embedding Large Auth + OWASP headers" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="Ocp-Apim-Subscription-Key" elementType="Header">
              <stringProp name="Header.name">Ocp-Apim-Subscription-Key</stringProp>
              <!-- text-embedding-3-large is Gold-tier only -->
              <stringProp name="Header.value">${GOLD_KEY}</stringProp>
            </elementProp>
            <elementProp name="Content-Type" elementType="Header">
              <stringProp name="Header.name">Content-Type</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
            <elementProp name="Accept" elementType="Header">
              <stringProp name="Header.name">Accept</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
            <elementProp name="User-Agent" elementType="Header">
              <stringProp name="Header.name">User-Agent</stringProp>
              <stringProp name="Header.value">Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>

        <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer"
                       testname="Think Time 30s" enabled="true">
          <stringProp name="ConstantTimer.delay">30000</stringProp>
        </ConstantTimer>
        <hashTree/>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                          testname="[Embedding Large] POST embeddings"
                          enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"input":"Hello world","model":"text-embedding-3-large"}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${APIM_HOSTNAME}</stringProp>
          <stringProp name="HTTPSampler.port">443</stringProp>
          <stringProp name="HTTPSampler.protocol">https</stringProp>
          <stringProp name="HTTPSampler.path">/openai/deployments/text-embedding-3-large/embeddings?api-version=${API_VERSION}</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                             testname="Assert 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Embedding Large must see 200 — text-embedding-3-large at steady-state load</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>

          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor"
                          testname="Extract X-Backend-Region-Used" enabled="true">
            <stringProp name="RegexExtractor.useHeaders">true</stringProp>
            <stringProp name="RegexExtractor.refname">backendRegion</stringProp>
            <stringProp name="RegexExtractor.regex">X-Backend-Region-Used: (.+?)[\r\n]</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">primary</stringProp>
            <stringProp name="RegexExtractor.match_no">1</stringProp>
          </RegexExtractor>
          <hashTree/>

          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor"
                               testname="Track Embedding Large backend counter" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
def region = vars.get("backendRegion") ?: "primary"
if (region.contains("secondary")) {
    props.get("embeddingLargeFailover").incrementAndGet()
} else {
    props.get("embeddingLargePrimary").incrementAndGet()
}
            </stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>

      <!-- ================================================================= -->
      <!-- tearDown: Per-subscription baseline report                         -->
      <!-- 0 failover = expected for steady-state; non-zero = investigation   -->
      <!-- ================================================================= -->
      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup"
                       testname="[tearDown] Per-subscription baseline report" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController"
                     guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">1</intProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
      </PostThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler"
                       testname="[Summary] Per-subscription baseline statistics" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
def bap   = (props.get("branchAdvisorPrimary")        as java.util.concurrent.atomic.AtomicInteger)?.get() ?: 0
def baf   = (props.get("branchAdvisorFailover")        as java.util.concurrent.atomic.AtomicInteger)?.get() ?: 0
def amlp  = (props.get("amlScreeningPrimary")          as java.util.concurrent.atomic.AtomicInteger)?.get() ?: 0
def amlf  = (props.get("amlScreeningFailover")         as java.util.concurrent.atomic.AtomicInteger)?.get() ?: 0
def cup   = (props.get("creditUnderwritingPrimary")    as java.util.concurrent.atomic.AtomicInteger)?.get() ?: 0
def cuf   = (props.get("creditUnderwritingFailover")   as java.util.concurrent.atomic.AtomicInteger)?.get() ?: 0
def ipp   = (props.get("investmentPlatformPrimary")    as java.util.concurrent.atomic.AtomicInteger)?.get() ?: 0
def ipf   = (props.get("investmentPlatformFailover")   as java.util.concurrent.atomic.AtomicInteger)?.get() ?: 0
def phi4mp = (props.get("phi4MiniPrimary")             as java.util.concurrent.atomic.AtomicInteger)?.get() ?: 0
def phi4mf = (props.get("phi4MiniFailover")            as java.util.concurrent.atomic.AtomicInteger)?.get() ?: 0
def phi4p  = (props.get("phi4Primary")                 as java.util.concurrent.atomic.AtomicInteger)?.get() ?: 0
def phi4f  = (props.get("phi4Failover")                as java.util.concurrent.atomic.AtomicInteger)?.get() ?: 0
def embSP  = (props.get("embeddingSmallPrimary")       as java.util.concurrent.atomic.AtomicInteger)?.get() ?: 0
def embSF  = (props.get("embeddingSmallFailover")      as java.util.concurrent.atomic.AtomicInteger)?.get() ?: 0
def embLP  = (props.get("embeddingLargePrimary")       as java.util.concurrent.atomic.AtomicInteger)?.get() ?: 0
def embLF  = (props.get("embeddingLargeFailover")      as java.util.concurrent.atomic.AtomicInteger)?.get() ?: 0

def baTotal    = bap   + baf
def amlTotal   = amlp  + amlf
def cuTotal    = cup   + cuf
def ipTotal    = ipp   + ipf
def phi4mTotal = phi4mp + phi4mf
def phi4Total  = phi4p  + phi4f
def embSTotal  = embSP  + embSF
def embLTotal  = embLP  + embLF
def total      = baTotal + amlTotal + cuTotal + ipTotal + phi4mTotal + phi4Total + embSTotal + embLTotal
def allFail    = baf + amlf + cuf + ipf + phi4mf + phi4f + embSF + embLF

// For steady-state: 0 failover = PASS; any failover = investigate
def baStatus    = baf   == 0 ? "PASS — all primary (expected)" : "INVESTIGATE — unexpected failover (${baf}/${baTotal})"
def amlStatus   = amlf  == 0 ? "PASS — all primary (expected)" : "INVESTIGATE — unexpected failover (${amlf}/${amlTotal})"
def cuStatus    = cuf   == 0 ? "PASS — all primary (expected)" : "INVESTIGATE — unexpected failover (${cuf}/${cuTotal})"
def ipStatus    = ipf   == 0 ? "PASS — all primary (expected)" : "INVESTIGATE — unexpected failover (${ipf}/${ipTotal})"
def phi4mStatus = phi4mf == 0 ? "PASS — all primary (expected)" : "INVESTIGATE — unexpected failover (${phi4mf}/${phi4mTotal})"
def phi4Status  = phi4f  == 0 ? "PASS — all primary (expected)" : "INVESTIGATE — unexpected failover (${phi4f}/${phi4Total})"
def embSStatus  = embSF  == 0 ? "PASS — all primary (expected)" : "INVESTIGATE — unexpected failover (${embSF}/${embSTotal})"
def embLStatus  = embLF  == 0 ? "PASS — all primary (expected)" : "INVESTIGATE — unexpected failover (${embLF}/${embLTotal})"

def msg = """
=== STEADY STATE BASELINE RESULTS ===

  [Branch Advisor]         total=${baTotal}  primary=${bap}  failover=${baf}  — ${baStatus}
  [AML Screening]          total=${amlTotal}  primary=${amlp}  failover=${amlf}  — ${amlStatus}
  [Credit Underwriting]    total=${cuTotal}  primary=${cup}  failover=${cuf}  — ${cuStatus}
  [Investment Platform]    total=${ipTotal}  primary=${ipp}  failover=${ipf}  — ${ipStatus}
  [AI Research]            total=${phi4mTotal}  primary=${phi4mp}  failover=${phi4mf}  — ${phi4mStatus}  (phi-4-mini)
  [Phi-4 Baseline]         total=${phi4Total}  primary=${phi4p}  failover=${phi4f}  — ${phi4Status}  (phi-4)
  [Embedding Small]        total=${embSTotal}  primary=${embSP}  failover=${embSF}  — ${embSStatus}  (text-embedding-3-small)
  [Embedding Large]        total=${embLTotal}  primary=${embLP}  failover=${embLF}  — ${embLStatus}  (text-embedding-3-large)

  [COMBINED]  total=${total}  failover=${allFail}

  Note: Failover at steady-state load (~180 TPM combined) indicates
  Foundry primary cap is lower than expected or another test is
  running concurrently and saturating shared capacity.

======================================
"""
log.info(msg)
SampleResult.setResponseData(msg, "UTF-8")
SampleResult.setResponseCodeOK()
SampleResult.setSampleLabel(
    "Baseline — total=${total}  BA:${bap}p/${baf}f  AML:${amlp}p/${amlf}f  CU:${cup}p/${cuf}f  IP:${ipp}p/${ipf}f  PHI4m:${phi4mp}p/${phi4mf}f  PHI4:${phi4p}p/${phi4f}f  EmbSm:${embSP}p/${embSF}f  EmbLg:${embLP}p/${embLF}f")
          </stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>

      <!-- Summary Report -->
      <ResultCollector guiclass="SummaryReport" testclass="ResultCollector"
                       testname="Summary Report" enabled="true">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time>
            <latency>true</latency>
            <timestamp>true</timestamp>
            <success>true</success>
            <label>true</label>
            <code>true</code>
            <message>true</message>
            <threadName>true</threadName>
            <bytes>true</bytes>
            <connectTime>true</connectTime>
          </value>
        </objProp>
        <stringProp name="filename"></stringProp>
      </ResultCollector>
      <hashTree/>

    </hashTree>
  </hashTree>
</jmeterTestPlan>
