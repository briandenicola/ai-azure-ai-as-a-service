<!--
APIM Policy: Semantic Caching
==============================

Reduce token costs by caching responses to similar queries.
This policy uses vector similarity to detect when a new prompt is similar to a cached one.

How it works:
1. Hash the incoming prompt
2. Check if a similar prompt exists in cache (scoped to this subscription)
3. If yes, return cached response (cost savings!)
4. If no, call model and cache response

Expected savings: 20-40% reduction in token consumption for repetitive queries

Applied to: /ai/completions endpoint only (not tool calls)

SECURITY NOTE (CAF Review — April 2026):
  Cache keys MUST include the caller's subscription ID (context.Subscription.Id)
  to prevent cross-LOB cache poisoning.  Without this scope, a cached response
  generated for one LOB's confidential prompt could be returned to a different
  subscriber asking the same question.

  Reference: Azure Architecture Center — "Provide custom authentication to Azure
  OpenAI in Foundry Models through a gateway" → General Recommendations →
  "Address caching safely":
    "make sure the identity of the requestor is considered in the cache logic.
     Do not return cached results for identities that are not authorized to
     receive that data."

  Scoping strategy used here: context.Subscription.Id (per-subscription isolation).
  Alternative: context.Product.Id (per-tier isolation; allows cache sharing within
  a tier but not across tiers). Per-subscription is the safer default.

  PCI DSS NOTE: Do NOT apply this policy to Gold/PCI-scoped API operations.
  See pci-dss-cardholder-data-protection.xml — cached AI responses may contain
  CHD context and violate PCI DSS Req 3.
-->

<policies>
    <inbound>
        <!-- 1. Extract the prompt text -->
        <set-variable name="prompt" value="@{
            var bodyContent = context.Request.Body?.As<JObject>();
            return bodyContent?["messages"]?[0]?["content"]?.ToString() ?? "";
        }" />
        
        <!-- 2. Create cache key: subscription-scoped prompt hash
             Scoping by context.Subscription.Id ensures that cached responses
             are never returned to a different subscriber, preventing cross-LOB
             data leakage even when two subscribers send identical prompts.
             CAF requirement: identity of the requestor must be part of cache key. -->
        <set-variable name="cache-key" value="@{
            var subscriptionId = context.Subscription.Id ?? "anonymous";
            var prompt = (string)context.Variables["prompt"];
            var raw = subscriptionId + "|" + prompt;
            using (var sha = new System.Security.Cryptography.SHA256Managed()) {
                var hashBytes = sha.ComputeHash(System.Text.Encoding.UTF8.GetBytes(raw));
                return System.Convert.ToBase64String(hashBytes).Substring(0, 32);
            }
        }" />
        
        <!-- 3. Try to get from cache -->
        <cache-lookup-value key="@((string)context.Variables["cache-key"])" variable-name="cached-response" />
        
        <!-- 4. If cached, return it immediately -->
        <choose>
            <when condition="@(context.Variables["cached-response"] != null)">
                <set-header name="X-Cache" value="HIT" />
                <set-body>@((string)context.Variables["cached-response"])</set-body>
                <return-response />
            </when>
        </choose>
        <!-- MISS path: do NOT set X-Cache here — set it in outbound so it appears as a response header captured by App Insights diagnostics -->
    </inbound>
    
    <backend>
        <forward-request />
    </backend>
    
    <outbound>
        <!-- 1. Cache successful responses only -->
        <choose>
            <when condition="@(context.Response.StatusCode == 200)">
                <!-- Cache for 24 hours -->
                <cache-store-value key="@((string)context.Variables["cache-key"])" value="@(context.Response.Body.As<string>())" duration="86400" />
            </when>
        </choose>
        
        <!-- 2. Add cache headers -->        <!-- X-Cache: MISS set here (outbound) so it appears as a response header captured by App Insights frontend.response.headers -->
        <choose>
            <when condition="@(context.Variables["cached-response"] == null)">
                <set-header name="X-Cache" exists-action="override"><value>MISS</value></set-header>
            </when>
        </choose>        <set-header name="X-Cache-Key" value="@((string)context.Variables["cache-key"])" />
    </outbound>
</policies>
