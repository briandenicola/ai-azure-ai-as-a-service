<!--
  Failover Retry Policy — openai-inference API
  =============================================
  Routes all requests to the primary Foundry endpoint.
  On HTTP 429 (rate-limit) or 5xx, retries once on the secondary endpoint and
  stamps X-Backend-Region-Used: secondary-failover so load-test JMeter
  assertions and App Insights queries can confirm the failover occurred.

  Named Values required (provisioned by apim-gateway.bicep):
    {{foundry-primary-endpoint}}   → https://contoso-foundry-primary.cognitiveservices.azure.com
    {{foundry-secondary-endpoint}} → https://contoso-foundry-secondary.cognitiveservices.azure.com

  Test approach: run-appgw-failover-test.ps1 temporarily lowers the primary
  gpt-4o-mini deployment to 1K TPM before the test and restores it after.
  Normal test traffic (~4 RPS) saturates 1K TPM quickly, generating genuine
  429s that trigger real APIM failover — no artificial routing logic needed.
-->
<policies>
    <inbound>
        <base />
        <set-variable name="selectedBackend" value="primary" />
        <set-backend-service base-url="{{foundry-primary-endpoint}}/openai" />
    </inbound>

    <backend>
        <retry condition="@(context.Response != null &amp;&amp; (context.Response.StatusCode == 429 || context.Response.StatusCode &gt;= 500))" count="1" interval="1" first-fast-retry="true">
            <choose>
                <when condition="@((string)context.Variables[&quot;selectedBackend&quot;] == &quot;primary&quot;)">
                    <set-backend-service base-url="{{foundry-secondary-endpoint}}/openai" />
                    <set-variable name="selectedBackend" value="secondary-failover" />
                </when>
            </choose>
            <forward-request timeout="60" />
        </retry>
    </backend>

    <outbound>
        <base />
        <set-header name="X-Backend-Region-Used" exists-action="override">
            <value>@((string)context.Variables["selectedBackend"])</value>
        </set-header>
    </outbound>

    <on-error>
        <base />
        <set-header name="X-Backend-Region-Used" exists-action="override">
            <value>@((string)context.Variables["selectedBackend"])</value>
        </set-header>
    </on-error>
</policies>
