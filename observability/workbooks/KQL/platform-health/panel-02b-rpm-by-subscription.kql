// Platform Health — Panel 2b: RPM per Subscription / LOB (stacked area chart)
// Data source:  AppRequests  (APIM App Insights inbound span)
// Parameters:   {TimeRange}        — workbook time-range picker
//               {Granularity}      — chart granularity picker (1m / 5m / 15m / 30m / 1h)
//               {SubscriptionName} — LOB subscription filter (value:all = no filter)
//
// Uses AppRequests (same source as the TPM panel) so {SubscriptionName} filtering is
// consistent: Properties["Subscription Name"] is the APIM subscription display name logged
// by APIM's App Insights telemetry, and it matches the values in the Subscription dropdown
// (which is also populated from AppRequests).
//
// One coloured band per APIM subscription key / LOB.
//
// A single LOB dominating (tall solid band) = that application is near its product RPM limit.
// Multiple bands growing simultaneously = combined load driving failover risk on primary Foundry.

let sub_filter  = "{SubscriptionName}";
let bucket_secs = totimespan("{Granularity}") / 1s;

AppRequests
| where TimeGenerated {TimeRange}
| extend sub = tostring(Properties["Subscription Name"])
| where isnotempty(sub)
| where sub_filter == "value:all" or sub == sub_filter
| summarize BucketRequests = count() by bin(TimeGenerated, {Granularity}), sub
| extend RPM = round(toreal(BucketRequests) / max_of(toreal(bucket_secs) / 60.0, 1.0), 1)
| project TimeGenerated, Subscription = sub, RPM
| sort by TimeGenerated asc
