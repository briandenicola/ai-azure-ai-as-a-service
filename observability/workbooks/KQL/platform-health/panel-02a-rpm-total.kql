// Platform Health — Panel 2a: Platform RPM — total requests/min (respects Subscription filter)
// Data source:  AppRequests  (APIM App Insights inbound span)
// Parameters:   {TimeRange}        — workbook time-range picker
//               {Granularity}      — chart granularity picker (1m / 5m / 15m / 30m / 1h)
//               {SubscriptionName} — LOB subscription filter (value:all = no filter)
//
// Uses AppRequests (same source as the TPM panel) so {SubscriptionName} filtering is
// consistent across all panels: Properties["Subscription Name"] matches the values in
// the Subscription dropdown, which is also populated from AppRequests.
// Ingestion lag ~2–5 min (acceptable for a health dashboard).
//
// RPM is normalised to the granularity bucket width — a 5-minute bucket of 50 requests
// yields RPM = 10, matching what a 1-minute bucket would show if the rate were steady.
//
// Useful companion to the TPM panel: RPM flat + TPM rising = requests using more tokens
// (larger prompts or longer responses). RPM rising + TPM flat = shorter requests, same load.

let sub_filter  = "{SubscriptionName}";
let bucket_secs = totimespan("{Granularity}") / 1s;

AppRequests
| where TimeGenerated {TimeRange}
| extend sub = tostring(Properties["Subscription Name"])
| where isnotempty(sub)
| where sub_filter == "value:all" or sub == sub_filter
| summarize BucketRequests = count() by bin(TimeGenerated, {Granularity})
| extend RPM = round(toreal(BucketRequests) / max_of(toreal(bucket_secs) / 60.0, 1.0), 1)
| project TimeGenerated, ['Requests/min'] = RPM
| sort by TimeGenerated asc
