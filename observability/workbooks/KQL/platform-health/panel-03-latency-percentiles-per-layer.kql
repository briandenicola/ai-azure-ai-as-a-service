// Platform Health — Panel 3: Latency Percentiles per Layer over Time (multi-line chart)
// Data source:  ApiManagementGatewayLogs joined to AGWAccessLogs
// Parameters:   {TimeRange}   — workbook time-range picker
//               {Granularity} — chart granularity picker (1m / 5m / 15m / 30m / 1h)
//
// Nine time-series lines across three layers × three percentiles:
//   App Gateway (blue family)  — WAF inspection + TLS termination, as seen by the client
//   APIM overhead (orange)     — policy execution: auth, quota check, cache, logging
//                                = APIM TotalTime − BackendTime
//   Foundry inference (green)  — AI model generation time at the backend
//
//   Percentiles: P50 (solid) · P95 (dashed) · P99 (dotted)
//
// How to read this chart:
//   P99 spike on Foundry inference = occasional slow model response (cold start, long prompt,
//     or secondary region round-trip adding ~300–500 ms during failover).
//   P99 spike on APIM overhead    = policy occasionally stalling — check semantic cache miss
//     storm or synchronous Key Vault lookup.
//   P99 spike on App GW            = WAF rule hit or TLS renegotiation; correlate with
//     AGWFirewallLogs for blocked rule IDs.
//   P50 and P99 diverging widely   = request mix is bimodal — short cache hits + long cold
//     inferences arriving in the same bucket.
//
// Join strategy:
//   APIM total time and Foundry backend time come from ApiManagementGatewayLogs (TotalTime,
//   BackendTime) — these fields are reliable per-request; no correlation ID needed.
//   APIM overhead = TotalTime − BackendTime (floored at 0 for retry-absorbed errors).
//   App GW is joined to APIM by time bucket only (no per-request correlation available from
//   AGWAccessLogs; TransactionId is only set when the AGW rewrite rule stamps X-Correlation-Id).
//   The App GW percentiles are therefore an independent aggregate for the same bucket,
//   not stitched per-request.  For per-request App GW timing, use the E2E Trace workbook.

let apim = ApiManagementGatewayLogs
| where TimeGenerated {TimeRange}
| where isnotempty(BackendUrl)
| extend apimOverheadMs = max_of(toreal(TotalTime) - toreal(BackendTime), 0.0)
| summarize
    ['Foundry P50 (ms)']        = round(percentile(toreal(BackendTime),  50), 1),
    ['Foundry P95 (ms)']        = round(percentile(toreal(BackendTime),  95), 1),
    ['Foundry P99 (ms)']        = round(percentile(toreal(BackendTime),  99), 1),
    ['APIM overhead P50 (ms)']  = round(percentile(apimOverheadMs,       50), 1),
    ['APIM overhead P95 (ms)']  = round(percentile(apimOverheadMs,       95), 1),
    ['APIM overhead P99 (ms)']  = round(percentile(apimOverheadMs,       99), 1)
  by bin(TimeGenerated, {Granularity});
let agw = AGWAccessLogs
| where TimeGenerated {TimeRange}
| summarize
    ['App GW P50 (ms)'] = round(percentile(toreal(TimeTaken), 50) * 1000, 1),
    ['App GW P95 (ms)'] = round(percentile(toreal(TimeTaken), 95) * 1000, 1),
    ['App GW P99 (ms)'] = round(percentile(toreal(TimeTaken), 99) * 1000, 1)
  by bin(TimeGenerated, {Granularity});
// Start from APIM data (always present when requests flow) and left-join AGW as optional.
// If App Gateway diagnostics are not enabled or traffic bypasses AGW, the APIM and
// Foundry percentile lines still render; App GW columns appear as empty/null.
apim
| join kind=leftouter agw on TimeGenerated
| project-away TimeGenerated1
| project
    TimeGenerated,
    ['App GW P50 (ms)'],
    ['App GW P95 (ms)'],
    ['App GW P99 (ms)'],
    ['APIM overhead P50 (ms)'],
    ['APIM overhead P95 (ms)'],
    ['APIM overhead P99 (ms)'],
    ['Foundry P50 (ms)'],
    ['Foundry P95 (ms)'],
    ['Foundry P99 (ms)']
| sort by TimeGenerated asc
