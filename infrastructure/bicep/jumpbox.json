{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.39.26.7824",
      "templateHash": "16842726096748161827"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all jumpbox resources"
      }
    },
    "prefix": {
      "type": "string",
      "defaultValue": "contoso",
      "metadata": {
        "description": "Short company prefix used in resource names"
      }
    },
    "vnetResourceId": {
      "type": "string",
      "metadata": {
        "description": "VNet resource ID — container group is injected into this VNet"
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {}
    }
  },
  "variables": {
    "containerGroupName": "[format('aci-{0}-jumpbox', parameters('prefix'))]",
    "jumpboxSubnetId": "[format('{0}/subnets/snet-jumpbox', parameters('vnetResourceId'))]",
    "initCommand": [
      "/bin/sh",
      "-c",
      "apk add --no-cache openjdk17-jre wget && pip3 install openai && wget -qO /tmp/jmeter.tgz https://archive.apache.org/dist/jmeter/binaries/apache-jmeter-5.6.3.tgz && tar -xzf /tmp/jmeter.tgz -C /opt && ln -sf /opt/apache-jmeter-5.6.3/bin/jmeter /usr/local/bin/jmeter && mkdir -p /root/apim-tests && sleep infinity"
    ]
  },
  "resources": [
    {
      "type": "Microsoft.ContainerInstance/containerGroups",
      "apiVersion": "2023-05-01",
      "name": "[variables('containerGroupName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "sku": "Standard",
        "containers": [
          {
            "name": "jumpbox",
            "properties": {
              "image": "mcr.microsoft.com/azure-cli:latest",
              "command": "[variables('initCommand')]",
              "resources": {
                "requests": {
                  "cpu": 1,
                  "memoryInGB": 1
                }
              }
            }
          }
        ],
        "osType": "Linux",
        "restartPolicy": "Always",
        "subnetIds": [
          {
            "id": "[variables('jumpboxSubnetId')]",
            "name": "snet-jumpbox"
          }
        ]
      }
    }
  ],
  "outputs": {
    "containerGroupName": {
      "type": "string",
      "value": "[variables('containerGroupName')]"
    },
    "containerGroupId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ContainerInstance/containerGroups', variables('containerGroupName'))]"
    }
  }
}