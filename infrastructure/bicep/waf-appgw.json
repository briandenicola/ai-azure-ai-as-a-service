{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.39.26.7824",
      "templateHash": "15691002052908785236"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "metadata": {
        "description": "Azure region for this App Gateway (e.g. eastus, westus)"
      }
    },
    "appGwName": {
      "type": "string",
      "metadata": {
        "description": "Application Gateway resource name"
      }
    },
    "vnetResourceId": {
      "type": "string",
      "metadata": {
        "description": "VNet resource ID that APIM is injected into. App Gateway is deployed into this same VNet."
      }
    },
    "appGwSubnetName": {
      "type": "string",
      "defaultValue": "snet-appgw",
      "metadata": {
        "description": "Name of the dedicated App Gateway subnet (must not contain any other resources and must have no delegation; minimum /26)"
      }
    },
    "apimInternalIpAddress": {
      "type": "string",
      "metadata": {
        "description": "APIM private IP address within the VNet — used as the App Gateway backend pool target. Comes from apim-gateway.bicep output apimPrivateIpAddress."
      }
    },
    "apimGatewayHostname": {
      "type": "string",
      "metadata": {
        "description": "APIM gateway hostname (e.g. contoso-ai.azure-api.net) for backend SNI and health probe host header"
      }
    },
    "sslCertKeyVaultSecretId": {
      "type": "securestring",
      "metadata": {
        "description": "Key Vault secret ID for the SSL certificate PFX (full URI including version). PCI DSS Req 4.2.1: TLS 1.2+ enforced at listener."
      }
    },
    "capacity": {
      "type": "int",
      "defaultValue": 2,
      "minValue": 1,
      "maxValue": 125,
      "metadata": {
        "description": "Minimum App Gateway scale units (2+ for HA; PCI DSS Req 12.3.4)"
      }
    },
    "availabilityZones": {
      "type": "array",
      "defaultValue": [
        "1",
        "2",
        "3"
      ],
      "metadata": {
        "description": "Availability zones for zone-redundant deployment (PCI DSS Req 12.3.4)"
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {}
    },
    "logAnalyticsWorkspaceId": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace resource ID for AppGW diagnostic settings. Pass the same workspace used by APIM diagnostics."
      }
    }
  },
  "variables": {
    "appGwSubnetId": "[format('{0}/subnets/{1}', parameters('vnetResourceId'), parameters('appGwSubnetName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('{0}-identity', parameters('appGwName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]"
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}-pip', parameters('appGwName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "zones": "[parameters('availabilityZones')]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "publicIPAddressVersion": "IPv4",
        "dnsSettings": {
          "domainNameLabel": "[toLower(parameters('appGwName'))]"
        }
      }
    },
    {
      "type": "Microsoft.Network/ApplicationGatewayWebApplicationFirewallPolicies",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}-waf-policy', parameters('appGwName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "policySettings": {
          "state": "Enabled",
          "mode": "Prevention",
          "requestBodyCheck": true,
          "maxRequestBodySizeInKb": 128,
          "fileUploadLimitInMb": 100
        },
        "managedRules": {
          "managedRuleSets": [
            {
              "ruleSetType": "OWASP",
              "ruleSetVersion": "3.2"
            },
            {
              "ruleSetType": "Microsoft_BotManagerRuleSet",
              "ruleSetVersion": "1.0"
            }
          ],
          "exclusions": []
        }
      }
    },
    {
      "type": "Microsoft.Network/applicationGateways",
      "apiVersion": "2023-05-01",
      "name": "[parameters('appGwName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "zones": "[parameters('availabilityZones')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appGwName'))))]": {}
        }
      },
      "properties": {
        "sku": {
          "name": "WAF_v2",
          "tier": "WAF_v2"
        },
        "autoscaleConfiguration": {
          "minCapacity": "[parameters('capacity')]",
          "maxCapacity": 10
        },
        "firewallPolicy": {
          "id": "[resourceId('Microsoft.Network/ApplicationGatewayWebApplicationFirewallPolicies', format('{0}-waf-policy', parameters('appGwName')))]"
        },
        "gatewayIPConfigurations": [
          {
            "name": "appgw-ip-config",
            "properties": {
              "subnet": {
                "id": "[variables('appGwSubnetId')]"
              }
            }
          }
        ],
        "frontendIPConfigurations": [
          {
            "name": "appgw-frontend-public",
            "properties": {
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', format('{0}-pip', parameters('appGwName')))]"
              }
            }
          }
        ],
        "frontendPorts": [
          {
            "name": "port-443",
            "properties": {
              "port": 443
            }
          }
        ],
        "sslCertificates": [
          {
            "name": "apim-ssl-cert",
            "properties": {
              "keyVaultSecretId": "[parameters('sslCertKeyVaultSecretId')]"
            }
          }
        ],
        "sslPolicy": {
          "policyType": "Predefined",
          "policyName": "AppGwSslPolicy20220101"
        },
        "httpListeners": [
          {
            "name": "appgw-https-listener",
            "properties": {
              "frontendIPConfiguration": {
                "id": "[resourceId('Microsoft.Network/applicationGateways/frontendIPConfigurations', parameters('appGwName'), 'appgw-frontend-public')]"
              },
              "frontendPort": {
                "id": "[resourceId('Microsoft.Network/applicationGateways/frontendPorts', parameters('appGwName'), 'port-443')]"
              },
              "protocol": "Https",
              "sslCertificate": {
                "id": "[resourceId('Microsoft.Network/applicationGateways/sslCertificates', parameters('appGwName'), 'apim-ssl-cert')]"
              },
              "firewallPolicy": {
                "id": "[resourceId('Microsoft.Network/ApplicationGatewayWebApplicationFirewallPolicies', format('{0}-waf-policy', parameters('appGwName')))]"
              },
              "requireServerNameIndication": false
            }
          }
        ],
        "backendAddressPools": [
          {
            "name": "apim-backend-pool",
            "properties": {
              "backendAddresses": [
                {
                  "ipAddress": "[parameters('apimInternalIpAddress')]"
                }
              ]
            }
          }
        ],
        "probes": [
          {
            "name": "apim-health-probe",
            "properties": {
              "protocol": "Https",
              "host": "[parameters('apimGatewayHostname')]",
              "path": "/status-0123456789abcdef",
              "interval": 30,
              "timeout": 30,
              "unhealthyThreshold": 3,
              "pickHostNameFromBackendHttpSettings": false,
              "match": {
                "statusCodes": [
                  "200-399"
                ]
              }
            }
          }
        ],
        "backendHttpSettingsCollection": [
          {
            "name": "apim-backend-settings",
            "properties": {
              "port": 443,
              "protocol": "Https",
              "cookieBasedAffinity": "Disabled",
              "requestTimeout": 180,
              "probe": {
                "id": "[resourceId('Microsoft.Network/applicationGateways/probes', parameters('appGwName'), 'apim-health-probe')]"
              },
              "pickHostNameFromBackendAddress": false,
              "hostName": "[parameters('apimGatewayHostname')]"
            }
          }
        ],
        "requestRoutingRules": [
          {
            "name": "apim-routing-rule",
            "properties": {
              "ruleType": "Basic",
              "priority": 100,
              "httpListener": {
                "id": "[resourceId('Microsoft.Network/applicationGateways/httpListeners', parameters('appGwName'), 'appgw-https-listener')]"
              },
              "backendAddressPool": {
                "id": "[resourceId('Microsoft.Network/applicationGateways/backendAddressPools', parameters('appGwName'), 'apim-backend-pool')]"
              },
              "backendHttpSettings": {
                "id": "[resourceId('Microsoft.Network/applicationGateways/backendHttpSettingsCollection', parameters('appGwName'), 'apim-backend-settings')]"
              },
              "rewriteRuleSet": {
                "id": "[resourceId('Microsoft.Network/applicationGateways/rewriteRuleSets', parameters('appGwName'), 'inject-correlation-id')]"
              }
            }
          }
        ],
        "rewriteRuleSets": [
          {
            "name": "inject-correlation-id",
            "properties": {
              "rewriteRules": [
                {
                  "name": "add-x-correlation-id",
                  "ruleSequence": 100,
                  "conditions": [],
                  "actionSet": {
                    "requestHeaderConfigurations": [
                      {
                        "headerName": "X-Correlation-Id",
                        "headerValue": "{var_client_ip}-{var_client_port}"
                      }
                    ],
                    "responseHeaderConfigurations": [
                      {
                        "headerName": "X-Correlation-Id",
                        "headerValue": "{var_client_ip}-{var_client_port}"
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appGwName')))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', format('{0}-pip', parameters('appGwName')))]",
        "[resourceId('Microsoft.Network/ApplicationGatewayWebApplicationFirewallPolicies', format('{0}-waf-policy', parameters('appGwName')))]"
      ]
    },
    {
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "scope": "[format('Microsoft.Network/applicationGateways/{0}', parameters('appGwName'))]",
      "name": "appgw-diagnostics",
      "properties": {
        "workspaceId": "[parameters('logAnalyticsWorkspaceId')]",
        "logAnalyticsDestinationType": "Dedicated",
        "logs": [
          {
            "category": "ApplicationGatewayAccessLog",
            "enabled": true
          },
          {
            "category": "ApplicationGatewayFirewallLog",
            "enabled": true
          },
          {
            "category": "ApplicationGatewayPerformanceLog",
            "enabled": true
          }
        ],
        "metrics": [
          {
            "category": "AllMetrics",
            "enabled": true
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/applicationGateways', parameters('appGwName'))]"
      ]
    }
  ],
  "outputs": {
    "appGwPublicIp": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', format('{0}-pip', parameters('appGwName'))), '2023-05-01').ipAddress]"
    },
    "appGwResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/applicationGateways', parameters('appGwName'))]"
    },
    "appGwFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', format('{0}-pip', parameters('appGwName'))), '2023-05-01').dnsSettings.fqdn]"
    },
    "appGwIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appGwName'))), '2023-01-31').principalId]"
    }
  }
}