# platform.env — local overrides for scripts/_resolve-env.ps1
#
# Copy this file to scripts/platform.env and fill in your values.
# This file is gitignored — it will never be committed.
# Leave a value blank to let _resolve-env.ps1 auto-discover it.
#
# Usage: all scripts that dot-source scripts/_resolve-env.ps1 will
# automatically pick up these values. No other changes required.

# ── Required ──────────────────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# ── Optional (auto-discovered from resource group if blank) ───────────────────
APIM_NAME=
AZURE_LOCATION=eastus
AZURE_COMPANY_PREFIX=contoso

# ── Observability resources (auto-discovered if blank) ────────────────────────
AZURE_LAW_CUSTOMER_ID=
AZURE_APP_INSIGHTS_NAME=
