# Azure OpenAI Configuration (for Semantic Kernel agents)
# Route through the APIM gateway — do NOT use a direct Foundry endpoint.
# Your APIM subscription key (Ocp-Apim-Subscription-Key) enforces your tier quota.
APIM_ENDPOINT=https://<company>-ai-gw-<suffix>.eastus.cloudapp.azure.com
APIM_SUBSCRIPTION_KEY=<your-apim-subscription-key>

# OpenAI-compatible inference through APIM (/openai API path)
AZURE_OPENAI_API_ENDPOINT=https://<company>-ai-gw-<suffix>.eastus.cloudapp.azure.com/openai/
MODEL_DEPLOYMENT_NAME=gpt-4o

# Set to false only if App Gateway uses a self-signed/dev TLS certificate.
# Leave as true (or omit) in production.
AZURE_SSL_VERIFY=true

# Azure AI Foundry Agents through APIM (/agents API path)
AZURE_PROJECT_ENDPOINT=https://<company>-ai-gw-<suffix>.eastus.cloudapp.azure.com
AZURE_AI_ELASTICSEARCH_AGENT_NAME=elasticsearch-agent
# Optional: Specify agent version (leave empty for latest)
AZURE_AI_ELASTICSEARCH_AGENT_NAME_VERSION=

GITHUB_PAT=
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=

# ServiceNow Configuration
SERVICENOW_INSTANCE=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_API_TOKEN=